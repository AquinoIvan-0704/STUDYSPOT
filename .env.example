# ==========================================================================
# StudySpot environment variables
#
# Copy this file to ".env" for local use, and paste the same values into
# Vercel under Settings -> Environment Variables for the deployed site.
#
# .env is in .gitignore — never commit the private key.
# ==========================================================================

# ---- public web config (safe to expose; the browser needs these) ----
FIREBASE_API_KEY=AIzaSyBaL8hOcatHEngQi8eom4OrwHGDwyH5f7w
FIREBASE_AUTH_DOMAIN=study-spot-edba9.firebaseapp.com
FIREBASE_PROJECT_ID=study-spot-edba9
FIREBASE_STORAGE_BUCKET=study-spot-edba9.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=154338440195
FIREBASE_APP_ID=1:154338440195:web:d48cef6782fa40f1eb4a36

# ---- service account (SECRET — server only) ----
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Open the downloaded JSON and copy these two values out.
# Keep the quotes and the \n escapes on the private key exactly as they appear.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@study-spot-edba9.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_THIS_WITH_THE_REAL_KEY\n-----END PRIVATE KEY-----\n"

# ---- optional ----
# Email addresses that should always be admins (comma separated).
ADMIN_EMAILS=

# Set to "files" to keep using data/*.json instead of Firestore.
# Leave empty for normal Firestore operation.
STUDYSPOT_STORAGE=

# Only used when running the local emulators.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
