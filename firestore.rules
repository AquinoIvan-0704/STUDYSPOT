rules_version = '2';

/*
  StudySpot security rules.

  Every read and write goes through the Express server, which uses the Admin
  SDK — and the Admin SDK bypasses these rules entirely. So browsers get no
  direct access at all. That keeps the rules simple and means all the
  authorisation logic lives in one place (server.js), where it can be read.

  If you ever move to querying Firestore straight from the browser, this file
  has to be opened up carefully — start from "deny everything" like below and
  add only what the client genuinely needs.
*/
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
